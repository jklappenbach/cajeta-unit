{
    // cajeta-unit — the test framework the Cajeta ecosystem is tested with:
    // reflective `@Test` discovery, `@BeforeEach` / `@AfterEach` / `@Disabled`,
    // fluent assertions, and a mocking engine (stubbing, argument matchers,
    // call verification).
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable `.cja`
    // rather than an executable. Consumers put that archive on the classpath of
    // their test binary and let `dev.cajeta.unit.Runner` discover their tests.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names the
    // built archive (`dev.cajeta.unit-<version>.cja`), it is what CI publishes to
    // Olla, and CI asserts that a `v*` tag agrees with it. There is deliberately
    // no VERSION file: cajeta-codec kept one alongside its manifest, the two
    // drifted, and a 0.7.1 cut shipped as a 0.7.0 artifact.

    "details": {
        "name":               "dev.cajeta.unit",
        "version":            "0.2.5",
        "description":        "cajeta-unit — test framework: @Test discovery, assertions, and mocks",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Declare only what the library's public API actually needs. A
        // pure-computation library may need none at all; capabilities are
        // re-validated against the consumer's manifest at the point of use.
        "capabilities": [],

        // Third-party runtime dependencies. The core stdlib (cajeta.lang,
        // cajeta.io, cajeta.codec, …) is built into the toolchain — neither
        // declared nor fetched — and only the parts your code uses are linked
        // into a consumer's binary (dead-code elimination).
        "dependencies": {},

        // No dev-dependencies: this project IS the test framework, and it tests
        // itself with itself (`SelfTest` hand-verifies the engine before trusting
        // it, then runs the reflective suite). The starter template's placeholder
        // `cajeta.testkit: 1.0.*` was carried here unedited and names a package
        // that does not exist in any repository.
        "dev-dependencies": {},

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` here — that is what makes this a library. With an
        // entry point the build emits an exe; without one it emits a .cja.
        "build": {
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's unit tests (fails on any failure)",
            "actions": [
                { "action": "build", "flavor": "debug", "profile": "test",
                  "entry-method": "dev.cajeta.unit.selftest.SelfTest.run",
                  "id": "testbin" },
                { "action": "test", "input": "${testbin.path}" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
